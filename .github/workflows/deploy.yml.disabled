name: Build and deploy

on:
  push:
    branches: [main]
  # The shared menu is baked at request time, but a nightly build keeps
  # generated dates and any scheduled content current.
  schedule:
    - cron: '17 4 * * *'
  workflow_dispatch:

concurrency:
  group: deploy
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: peaceiris/actions-hugo@v3
        with:
          hugo-version: '0.165.0'
          extended: true

      - name: Build
        run: hugo --minify --gc --cleanDestinationDir

      - name: Guard against an empty or truncated build
        run: |
          count=$(find public -name index.html | wc -l)
          echo "built $count pages"
          # The archive alone is ~590 pages; anything far below that means the
          # build silently lost content and must not reach the live site.
          if [ "$count" -lt 500 ]; then
            echo "::error::only $count pages built - refusing to deploy"
            exit 1
          fi

      - uses: webfactory/ssh-agent@v0.9.0
        with:
          ssh-private-key: ${{ secrets.DEPLOY_KEY }}

      - name: Trust the host key
        run: |
          mkdir -p ~/.ssh
          echo "${{ secrets.DEPLOY_KNOWN_HOSTS }}" >> ~/.ssh/known_hosts

      - name: Ship it
        run: |
          rsync -az --delete --checksum \
            public/ "${{ secrets.DEPLOY_TARGET }}"
